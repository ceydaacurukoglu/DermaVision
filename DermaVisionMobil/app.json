{
  "expo": {
    "name": "DermaVision",
    "slug": "dermavision-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "derma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.dermavision.app",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F7FC"
      }
    },
    "ios": {
      "bundleIdentifier": "com.dermavision.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Cilt fotoğrafı çekebilmek için kameraya erişim gerekir.",
        "NSPhotoLibraryUsageDescription": "Galeriden cilt fotoğrafı seçebilmek için erişim gerekir."
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cilt fotoğrafı çekebilmek için kameraya erişim gerekir.",
          "photosPermission": "Galeriden cilt fotoğrafı seçebilmek için erişim gerekir."
        }
      ],
      "expo-web-browser"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F7FC"
    }
  }
}